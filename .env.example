# 96 Nation — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Full matrix (local/preview/prod): docs/ENV.md
# Phase 0 + live cutover: docs/CUTOVER.md
# Design background: DESIGN.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TICKETING_ENABLED=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# --- Supabase (DB + admin auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_NOTIFY_EMAIL=
ADMIN_EMAILS=

# --- Upstash (rate limits; required in production for multi-instance limits) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev-only: allow form POST 200 without Supabase service role (never set in prod)
# ALLOW_UNPERSISTED_FORMS=1

# --- Sentry ---
SENTRY_DSN=

# --- Internal secrets ---
CRON_SECRET=
INVENTORY_SYNC_SECRET=

# --- Ticketing config ---
FACILITY_FEE_CENTS=100
DEFAULT_PHONE_REGION=US
